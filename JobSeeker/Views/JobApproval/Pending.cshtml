@{
    ViewData["Title"] = "Pending Job Approvals";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Postings</h2>
    <div class="d-flex gap-2">
        <a asp-action="Pending" class="btn btn-warning btn-sm">Pending</a>
        <a asp-action="Approved" class="btn btn-outline-success btn-sm">Approved</a>
        <a asp-action="Rejected" class="btn btn-outline-danger btn-sm">Rejected</a>
    </div>
</div>

<!-- Job Cards -->
<div class="row g-3">
    <!-- Placeholder Card -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="mb-1">Senior Software Engineer</h5>
                        <div class="text-muted small">Acme Corporation</div>
                    </div>
                    <span class="badge bg-warning text-dark">Pending</span>
                </div>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-light text-dark border">Full Time</span>
                    <span class="badge bg-light text-dark border">Remote</span>
                    <span class="badge bg-light text-dark border">Kuala Lumpur</span>
                </div>
                <ul class="list-unstyled small text-muted mb-3">
                    <li><strong>Salary:</strong> RM 5,000 – RM 8,000</li>
                    <li><strong>Deadline:</strong> 31 Aug 2026</li>
                    <li><strong>Submitted:</strong> 05 Aug 2026</li>
                </ul>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary flex-fill">View Details</button>
                    <button class="btn btn-sm btn-success flex-fill">Approve</button>
                    <button class="btn btn-sm btn-danger flex-fill">Reject</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <p class="text-muted text-center py-4">No pending job postings at this time.</p>
    </div>
</div>
