
@{
    ViewData["Title"] = "Resume Feedback Requests";
}
<head>
    <link rel="stylesheet" href="~/css/Counsellor.css" />
</head>



<div class="container py-4">
    <div id="messageArea"></div>
    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mb-4">

        <div>
            <h1 class="h3 mb-1">Resume Feedback Requests</h1>
        </div>
        <button type="button"
                class="btn btn-outline-danger"
                onclick="resetSampleData()">
            Reset Sample Data
        </button>
        <div style="min-width: 100px;">

            <select id="statusFilter" class="form-select">
                <option value="ALL">All</option>
                <option value="NEW">New</option>
                <option value="IN_PROGRESS">In Progress</option>
                <option value="COMPLETED">Completed</option>
                <option value="DISMISSED">Dismissed</option>
            </select>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Job Seeker</th>
                            <th>Resume</th>
                            <th>Request Message</th>
                            <th style="min-width:150px">Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="requestTableBody"></tbody>
                </table>
            </div>

            <div id="emptyMessage"
                 class="text-center text-muted py-5 d-none">
                No requests were found for the selected status.
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="requestModal"
     tabindex="-1"
     aria-labelledby="requestModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="requestModalLabel">
                    Resume Feedback Request
                </h2>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Job Seeker</dt>
                    <dd class="col-sm-8" id="modalJobSeeker"></dd>

                    <dt class="col-sm-4">Resume</dt>
                    <dd class="col-sm-8" id="modalResume"></dd>

                    <dt class="col-sm-4">Request</dt>
                    <dd class="col-sm-8" id="modalDescription"></dd>
                </dl>

                <div id="newRequestMessage"
                     class="alert alert-info mt-3 mb-0">
                    Accept this request to begin reviewing the resume,
                    or decline it to dismiss the task.
                </div>
            </div>

            <div class="modal-footer" id="newRequestActions">
                <button type="button"
                        class="btn btn-outline-danger"
                        onclick="declineRequest()">
                    Decline Task
                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="acceptRequest()">
                    Accept Task
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const storageKey = "resumeFeedbackRequests";

        const sampleRequests = [
            {
                id: 1,
                jobSeeker: "Ali Ahmad",
                resumeTitle: "Software Developer Resume",
                description:
                    "Please review my resume before I apply for junior developer positions.",
                submittedDate: "2026-08-06",
                status: "NEW"
            },
            {
                id: 5,
                jobSeeker: "Ali Ahmad",
                resumeTitle: "Software Developer Resume",
                description:
                    "Please review my resume before I apply for junior developer positions.",
                submittedDate: "2026-08-06",
                status: "NEW"
            },
            {
                id: 2,
                jobSeeker: "Siti Aminah",
                resumeTitle: "Business Analyst Resume",
                description:
                    "I need suggestions to improve my skills and experience section.",
                submittedDate: "2026-08-05",
                status: "IN_PROGRESS"
            },
            {
                id: 3,
                jobSeeker: "John Tan",
                resumeTitle: "UI/UX Designer Resume",
                description:
                    "Please check whether my portfolio experience is explained clearly.",
                submittedDate: "2026-08-03",
                status: "COMPLETED"
            },
            {
                id: 4,
                jobSeeker: "Nur Aisyah",
                resumeTitle: "Marketing Executive Resume",
                description:
                    "Please review the structure and content of my resume.",
                submittedDate: "2026-08-02",
                status: "DISMISSED"
            }
        ];

        let requests = [];
        let selectedRequestId = null;
        let requestModal = null;

        document.addEventListener("DOMContentLoaded", function() {
            initialiseRequests();

            requestModal = new bootstrap.Modal(
                document.getElementById("requestModal")
            );

            document
                .getElementById("statusFilter")
                .addEventListener("change", renderRequests);

            renderRequests();
        });

        function initialiseRequests() {
            const storedRequests = localStorage.getItem(storageKey);

            if (storedRequests) {
                requests = JSON.parse(storedRequests);
            } else {
                requests = sampleRequests;
                saveRequests();
            }
        }

        function resetSampleData() {
            localStorage.removeItem("resumeFeedbackRequests");
            localStorage.removeItem("resumeFeedbackDrafts");
            location.reload();
        }

        function saveRequests() {
            localStorage.setItem(storageKey, JSON.stringify(requests));
        }

        function renderRequests() {
            const selectedStatus =
                document.getElementById("statusFilter").value;

            const tableBody =
                document.getElementById("requestTableBody");

            const emptyMessage =
                document.getElementById("emptyMessage");

            const filteredRequests = requests.filter(function(request) {
                return selectedStatus === "ALL" ||
                    request.status === selectedStatus;
            });

            tableBody.innerHTML = "";

            if (filteredRequests.length === 0) {
                emptyMessage.classList.remove("d-none");
                return;
            }

            emptyMessage.classList.add("d-none");

            filteredRequests.forEach(function(request) {
                const row = document.createElement("tr");

                row.innerHTML = `
                            <td class="px-4 py-4">
                                <div class="fw-semibold">
                                    ${escapeHtml(request.jobSeeker)}
                                </div>
                            </td>

                            <td class="px-4 py-4">
                                ${escapeHtml(request.resumeTitle)}
                            </td>

                            <td class="px-4 py-4" style="min-width: 200px;">
                                ${escapeHtml(request.description)}
                            </td>

                            <td class="text-center">
                                ${formatDate(request.submittedDate)}
                            </td>

                            <td class="text-center px-4 py-4">
                                    ${createStatusBadge(request.status)}
                            </td>

                            <td class="px-4 text-center">
                                ${createActionButton(request)}
                            </td>
                        `;

                tableBody.appendChild(row);
            });
        }

        function createActionButton(request) {
            if (request.status === "NEW") {
                return `
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            style="width: 75px;"
                            onclick="openRequest(${request.id})">
                        View
                    </button>
                `;
            }
            if (request.status === "IN_PROGRESS") {
                return `
                    <a class="btn btn-sm btn-outline-primary"
                       style="width: 75px;"
                       href="/CareerCounsellor/ResumeFeedbackForm?requestId=${request.id}">
                        Continue
                    </a>
                `;
            }
            if (request.status === "COMPLETED") {
                return `
                            <a class="btn btn-sm btn-outline-primary"
                                    style="width:75px"
                               href="/CareerCounsellor/ResumeFeedbackForm?requestId=${request.id}">
                                View
                            </a>
                        `;
            }
            return `
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                        style="width:75px"
                                onclick="openRequest(${request.id})">
                                    View
                        </button>
                    `;
        }

        function createStatusBadge(status) {
            if (status === "NEW") {
                return '<span class="badge badge-new d-inline-flex align-items-center justify-content-center">New</span>';
            }

            if (status === "IN_PROGRESS") {
                return '<span class="badge badge-progress d-inline-flex align-items-center justify-content-center">In Progress</span>';
            }

            if (status === "COMPLETED") {
                return '<span class="badge badge-completed d-inline-flex align-items-center justify-content-center">Completed</span>';
            }

            return '<span class="badge badge-dismissed d-inline-flex align-items-center justify-content-center">Dismissed</span>';
        }


        function openRequest(requestId) {
            const request = requests.find(function(item) {
                return item.id === requestId;
            });

            if (!request) {
                return;
            }

            selectedRequestId = requestId;

            document.getElementById("modalJobSeeker").textContent =
                request.jobSeeker;

            document.getElementById("modalResume").textContent =
                request.resumeTitle;

            document.getElementById("modalDescription").textContent =
                request.description;

            const actions =
                document.getElementById("newRequestActions");

            const information =
                document.getElementById("newRequestMessage");

            if (request.status === "NEW") {
                actions.classList.remove("d-none");
                information.classList.remove("d-none");
            } else {
                actions.classList.add("d-none");
                information.classList.add("d-none");
            }

            requestModal.show();
        }

        function acceptRequest() {
            const request = requests.find(function(item) {
                return item.id === selectedRequestId;
            });

            if (!request || request.status !== "NEW") {
                return;
            }

            request.status = "IN_PROGRESS";
            saveRequests();

            window.location.href =
                "/CareerCounsellor/ResumeFeedbackForm?requestId=" +
                request.id;
        }

        function declineRequest() {
            const request = requests.find(function(item) {
                return item.id === selectedRequestId;
            });

            if (!request || request.status !== "NEW") {
                return;
            }

            request.status = "DISMISSED";
            saveRequests();

            requestModal.hide();
            renderRequests();

        }

        function showMessage(message, type) {
            const messageArea =
                document.getElementById("messageArea");

            messageArea.innerHTML = `
                        <div class="alert alert-${type} alert-dismissible fade show">
                            ${escapeHtml(message)}

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>
                        </div>
                    `;
        }

        function formatDate(dateValue) {
            return new Date(dateValue).toLocaleDateString(
                "en-MY",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                }
            );
        }

        function escapeHtml(value) {
            const element = document.createElement("div");
            element.textContent = value ?? "";
            return element.innerHTML;
        }
    </script>
}