@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>System Reports</h2>
</div>

<div class="row g-4">
    <!-- Generate Report -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Generate New Report</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Report Type</label>
                    <select class="form-select">
                        <option value="">Select report type...</option>
                        <option>User Summary Report</option>
                        <option>Employer Verification Report</option>
                        <option>Job Postings Report</option>
                        <option>Application Statistics Report</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Date Range</label>
                    <div class="row g-2">
                        <div class="col">
                            <input type="date" class="form-control" placeholder="From" />
                        </div>
                        <div class="col-auto d-flex align-items-center text-muted">to</div>
                        <div class="col">
                            <input type="date" class="form-control" placeholder="To" />
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Export Format</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="format" id="formatPdf" checked />
                            <label class="form-check-label" for="formatPdf">PDF</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="format" id="formatCsv" />
                            <label class="form-check-label" for="formatCsv">CSV</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="format" id="formatExcel" />
                            <label class="form-check-label" for="formatExcel">Excel</label>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary w-100">Generate Report</button>
            </div>
        </div>
    </div>

    <!-- Report History -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Report History</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Report Name</th>
                                <th>Type</th>
                                <th>Generated By</th>
                                <th>Date</th>
                                <th>Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Placeholder row -->
                            <tr>
                                <td>User Summary – Jul 2026</td>
                                <td><span class="badge bg-secondary">User Summary</span></td>
                                <td>Admin</td>
                                <td>01 Aug 2026</td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-outline-primary">Download</a>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No reports generated yet.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
