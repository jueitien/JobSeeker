@model int

<li class="nav-item">
    <a class="nav-link text-dark notification-nav-link"
       asp-controller="Notifications"
       asp-action="Index">
        Notifications
        @if (Model > 0)
        {
            <span class="badge rounded-pill bg-danger notification-nav-badge">
                @Model
                <span class="visually-hidden">unread notifications</span>
            </span>
        }
    </a>
</li>
