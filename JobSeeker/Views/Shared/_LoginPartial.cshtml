@using Microsoft.AspNetCore.Identity
@using JobSeeker.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "Account";
    var displayEmail = currentUser?.Email ?? string.Empty;
    var avatarUrl = !string.IsNullOrWhiteSpace(currentUser?.ProfileImageS3Key)
        ? Url.Action("ProfileImage", "Account")
        : Url.Content("~/images/default-avatar.svg");

    <li class="nav-item dropdown account-nav-dropdown">
        <button class="btn account-avatar-button dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="Open account menu">
            <img src="@avatarUrl" alt="Profile" class="nav-profile-image" />
        </button>

        <div class="dropdown-menu dropdown-menu-end account-dropdown-menu">
            <div class="account-dropdown-header">
                <img src="@avatarUrl" alt="Profile" class="account-dropdown-avatar" />
                <div class="min-w-0">
                    <strong>@displayName</strong>
                    <small>@displayEmail</small>
                </div>
            </div>

            <div class="dropdown-divider"></div>

            @if (User.IsInRole(UserRoles.JobSeeker))
            {
                <a class="dropdown-item account-dropdown-item"
                   asp-controller="Profile"
                   asp-action="Index">
                    My Profile
                </a>

                <a class="dropdown-item account-dropdown-item"
                   asp-controller="Profile"
                   asp-action="Edit">
                    Edit Profile
                </a>

                <a class="dropdown-item account-dropdown-item"
                   asp-controller="Applications"
                   asp-action="Index">
                    My Applications
                </a>

                <a class="dropdown-item account-dropdown-item"
                   asp-controller="Notifications"
                   asp-action="Index">
                    Notifications
                </a>

                <a class="dropdown-item account-dropdown-item"
                   asp-controller="Feedback"
                   asp-action="Index">
                    Feedback & Insights
                </a>
            }

            <a class="dropdown-item account-dropdown-item"
               asp-controller="Account"
               asp-action="EditAccount">
                    Account Settings
            </a>

            @if (User.IsInRole(UserRoles.Employer))
            {
                <a class="dropdown-item account-dropdown-item"
                   asp-controller="Company"
                   asp-action="Index">
                    Manage Company
                </a>
            }

            <div class="dropdown-divider"></div>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item account-dropdown-item text-danger">
                    Logout
                </button>
            </form>
        </div>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
