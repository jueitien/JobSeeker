@model JobSeeker.Models.Employer.VacanciesPageViewModel

@{
    ViewData["Title"] = "Job Vacancies";
    // If the Post action returned this view because validation failed,
    // ModelState will contain errors tied to "NewVacancy.*" keys.
    // Reopen the modal automatically so the errors are actually visible.
    bool hasNewVacancyErrors = ViewData.ModelState.Keys.Any(k => k.StartsWith("NewVacancy"));
}

<link rel="stylesheet" href="~/css/employer.css" asp-append-version="true" />

@* ── Page Header ── *@
<div class="emp-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-1">Job Vacancies</h2>
            <p class="text-muted mb-0">Manage your posted vacancies or create a new one.</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#postVacancyModal">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" class="me-1" style="vertical-align:-2px">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Post a Vacancy
        </button>
    </div>
</div>

@* ── Success Alert ── *@
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" class="me-2" style="vertical-align:-2px">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* ── Search & Filter Bar ── *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Vacancies" asp-action="Index" method="get" id="filterForm">
            <div class="row g-2 align-items-end">

                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z" />
                            </svg>
                        </span>
                        <input type="text" name="searchKeyword" class="form-control border-start-0"
                               placeholder="Title, company, or keyword…"
                               value="@Model.SearchKeyword" />
                    </div>
                </div>

                <div class="col-sm-6 col-md-2">
                    <label class="form-label small text-muted mb-1">Employment Type</label>
                    <select name="filterEmploymentType" class="form-select">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.FilterEmploymentType) || Model.FilterEmploymentType == "All")">All Types</option>
                        <option value="FULL_TIME"  selected="@(Model.FilterEmploymentType == "FULL_TIME")">Full-Time</option>
                        <option value="PART_TIME"  selected="@(Model.FilterEmploymentType == "PART_TIME")">Part-Time</option>
                        <option value="CONTRACT"   selected="@(Model.FilterEmploymentType == "CONTRACT")">Contract</option>
                        <option value="INTERNSHIP" selected="@(Model.FilterEmploymentType == "INTERNSHIP")">Internship</option>
                    </select>
                </div>

                <div class="col-sm-6 col-md-2">
                    <label class="form-label small text-muted mb-1">Workplace</label>
                    <select name="filterWorkplaceType" class="form-select">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.FilterWorkplaceType) || Model.FilterWorkplaceType == "All")">All</option>
                        <option value="ON_SITE" selected="@(Model.FilterWorkplaceType == "ON_SITE")">On-Site</option>
                        <option value="HYBRID"  selected="@(Model.FilterWorkplaceType == "HYBRID")">Hybrid</option>
                        <option value="REMOTE"  selected="@(Model.FilterWorkplaceType == "REMOTE")">Remote</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Location</label>
                    <input type="text" name="filterLocation" class="form-control"
                           placeholder="e.g. Kota Kinabalu"
                           value="@Model.FilterLocation" />
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                    <a asp-controller="Vacancies" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>

            </div>
        </form>
    </div>
</div>

@* ── Results Count ── *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">
        Showing <strong>@Model.PublishedVacancies.Count</strong> vacanc@(Model.PublishedVacancies.Count == 1 ? "y" : "ies")
        @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
        {
            <text> for "<em>@Model.SearchKeyword</em>"</text>
        }
    </span>
</div>

@* ── Vacancy Cards ── *@
@if (!Model.PublishedVacancies.Any())
{
    <div class="text-center py-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" class="text-muted mb-3" style="opacity:.35">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h5 class="text-muted">No vacancies posted yet</h5>
        <p class="text-muted small">Click "Post a Vacancy" to create your first job listing.</p>
    </div>
}
else
{
    <div class="row g-3" id="vacancyGrid">
        @foreach (var job in Model.PublishedVacancies)
        {
            <div class="col-lg-6 col-xl-4 vacancy-item">
                <div class="card border-0 shadow-sm h-100 vac-card">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="vac-company-logo">@job.CompanyName.Substring(0, 1).ToUpper()</div>
                            <div class="d-flex flex-column align-items-end gap-1">
                                <span class="badge vac-badge-jobtype vac-jobtype-@job.EmploymentType.ToLower().Replace("_","")">
                                    @Friendly(job.EmploymentType)
                                </span>
                                @{
                                    var statusBadgeClass = job.ApprovalStatus switch
                                    {
                                        "APPROVED" => "bg-success",
                                        "REJECTED" => "bg-danger",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @statusBadgeClass">@Friendly(job.ApprovalStatus)</span>
                            </div>
                        </div>

                        <h5 class="card-title mb-1 fw-semibold">@job.JobTitle</h5>
                        <p class="text-muted small mb-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" class="me-1" style="vertical-align:-1px">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0H5m14 0l-7-7-7 7" />
                            </svg>
                            @job.CompanyName
                        </p>

                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @if (!string.IsNullOrWhiteSpace(job.Location))
                            {
                                <span class="vac-chip">@job.Location</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(job.WorkplaceType))
                            {
                                <span class="vac-chip">@Friendly(job.WorkplaceType)</span>
                            }
                            @if (job.MinimumSalary.HasValue || job.MaximumSalary.HasValue)
                            {
                                <span class="vac-chip vac-chip-salary">
                                    RM @job.MinimumSalary?.ToString("N0") - RM @job.MaximumSalary?.ToString("N0")
                                </span>
                            }
                            <span class="vac-chip @(job.JobStatus == "OPEN" ? "" : "text-danger")">
                                @(job.JobStatus == "OPEN" ? "Open" : "Closed") · @job.VacancyCount vacanc@(job.VacancyCount == 1 ? "y" : "ies")
                            </span>
                        </div>

                        <p class="small text-muted vac-desc-clamp mb-3">@job.JobDescription</p>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted" style="font-size:.75rem">
                                    Posted @job.CreatedAt.ToString("dd MMM yyyy")
                                </span>
                                @if (job.ApplicationDeadline.HasValue)
                                {
                                    var daysLeft = job.ApplicationDeadline.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
                                    var cls = daysLeft <= 7 ? "text-danger" : "text-muted";
                                    <span class="@cls" style="font-size:.75rem">
                                        @if (daysLeft < 0) { <text>Closed</text> }
                                        else if (daysLeft == 0) { <text>Closes today</text> }
                                        else { <text>@daysLeft day@(daysLeft == 1 ? "" : "s") left</text> }
                                    </span>
                                }
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary btn-sm flex-grow-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#vacancyDetailModal"
                                        data-title="@job.JobTitle"
                                        data-company="@job.CompanyName"
                                        data-location="@(job.Location ?? "Not specified")"
                                        data-employmenttype="@Friendly(job.EmploymentType)"
                                        data-workplacetype="@Friendly(job.WorkplaceType ?? "")"
                                        data-salary="@(job.MinimumSalary.HasValue || job.MaximumSalary.HasValue ? $"RM {job.MinimumSalary?.ToString("N0")} - RM {job.MaximumSalary?.ToString("N0")}" : "Not specified")"
                                        data-description="@job.JobDescription"
                                        data-requirements="@job.Responsibilities"
                                        data-deadline="@(job.ApplicationDeadline?.ToString("dd MMM yyyy") ?? "Open")"
                                        data-status="@Friendly(job.ApprovalStatus)"
                                        data-postedon="@job.CreatedAt.ToString("dd MMM yyyy")">
                                    View Details
                                </button>

                                @if (job.JobStatus == "OPEN")
                                {
                                    <form asp-controller="Vacancies" asp-action="Close" method="post" onsubmit="return confirm('Close this vacancy? Job seekers will no longer be able to apply.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@job.JobId" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Close</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Vacancies" asp-action="Reopen" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@job.JobId" />
                                        <button type="submit" class="btn btn-outline-success btn-sm">Reopen</button>
                                    </form>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}


@* ── Modal: Post a Vacancy ── *@
<div class="modal fade" id="postVacancyModal" tabindex="-1"
     aria-labelledby="postVacancyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="postVacancyModalLabel">Post a New Vacancy</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Vacancies" asp-action="Post" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="alert alert-info small">
                        Newly posted vacancies require Administrator approval before they appear to job seekers.
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="NewVacancy.JobTitle" class="form-label"></label>
                            <input asp-for="NewVacancy.JobTitle" class="form-control" placeholder="e.g. Software Engineer" />
                            <span asp-validation-for="NewVacancy.JobTitle" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewVacancy.CompanyName" class="form-label"></label>
                            <input asp-for="NewVacancy.CompanyName" class="form-control" placeholder="e.g. Tech Solutions Inc." />
                            <span asp-validation-for="NewVacancy.CompanyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="NewVacancy.Location" class="form-label"></label>
                            <input asp-for="NewVacancy.Location" class="form-control" placeholder="e.g. Kota Kinabalu, Sabah" />
                            <span asp-validation-for="NewVacancy.Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NewVacancy.EmploymentType" class="form-label"></label>
                            <select asp-for="NewVacancy.EmploymentType" class="form-select">
                                <option value="">— Select —</option>
                                <option value="FULL_TIME">Full-Time</option>
                                <option value="PART_TIME">Part-Time</option>
                                <option value="CONTRACT">Contract</option>
                                <option value="INTERNSHIP">Internship</option>
                            </select>
                            <span asp-validation-for="NewVacancy.EmploymentType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NewVacancy.WorkplaceType" class="form-label"></label>
                            <select asp-for="NewVacancy.WorkplaceType" class="form-select">
                                <option value="">— Select —</option>
                                <option value="ON_SITE">On-Site</option>
                                <option value="HYBRID">Hybrid</option>
                                <option value="REMOTE">Remote</option>
                            </select>
                            <span asp-validation-for="NewVacancy.WorkplaceType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="NewVacancy.MinimumQualification" class="form-label"></label>
                            <input asp-for="NewVacancy.MinimumQualification" class="form-control" placeholder="e.g. Bachelor Degree" />
                            <span asp-validation-for="NewVacancy.MinimumQualification" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewVacancy.PreferredFieldOfStudy" class="form-label"></label>
                            <input asp-for="NewVacancy.PreferredFieldOfStudy" class="form-control" placeholder="e.g. Software Engineering" />
                            <span asp-validation-for="NewVacancy.PreferredFieldOfStudy" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewVacancy.MinimumExperienceYears" class="form-label"></label>
                            <input asp-for="NewVacancy.MinimumExperienceYears" class="form-control" type="number" step="0.5" min="0" />
                            <span asp-validation-for="NewVacancy.MinimumExperienceYears" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="NewVacancy.MinimumSalary" class="form-label"></label>
                            <input asp-for="NewVacancy.MinimumSalary" class="form-control" type="number" step="50" min="0" placeholder="e.g. 3000" />
                            <span asp-validation-for="NewVacancy.MinimumSalary" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewVacancy.MaximumSalary" class="form-label"></label>
                            <input asp-for="NewVacancy.MaximumSalary" class="form-control" type="number" step="50" min="0" placeholder="e.g. 5000" />
                            <span asp-validation-for="NewVacancy.MaximumSalary" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewVacancy.VacancyCount" class="form-label"></label>
                            <input asp-for="NewVacancy.VacancyCount" class="form-control" type="number" min="1" />
                            <span asp-validation-for="NewVacancy.VacancyCount" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="NewVacancy.ApplicationDeadline" class="form-label"></label>
                            <input asp-for="NewVacancy.ApplicationDeadline" class="form-control" type="date"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="NewVacancy.ApplicationDeadline" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewVacancy.JobDescription" class="form-label"></label>
                        <textarea asp-for="NewVacancy.JobDescription" class="form-control" rows="4"
                                  placeholder="Describe the role and what you're looking for…"></textarea>
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="NewVacancy.JobDescription" class="text-danger small"></span>
                            <span class="text-muted small" id="descCount">0 / 4000</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewVacancy.Responsibilities" class="form-label"></label>
                        <textarea asp-for="NewVacancy.Responsibilities" class="form-control" rows="4"
                                  placeholder="List key responsibilities…"></textarea>
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="NewVacancy.Responsibilities" class="text-danger small"></span>
                            <span class="text-muted small" id="reqCount">0 / 4000</span>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit for Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>


@* ── Modal: Vacancy Detail ── *@
<div class="modal fade" id="vacancyDetailModal" tabindex="-1"
     aria-labelledby="vacancyDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0" id="vacancyDetailModalLabel">Job Title</h5>
                    <span class="text-muted small" id="detailCompany">Company</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-2 mb-4" id="detailChips"></div>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <span class="vac-detail-label">Location</span>
                        <div id="detailLocation" class="fw-medium">—</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="vac-detail-label">Salary</span>
                        <div id="detailSalary" class="fw-medium">—</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="vac-detail-label">Deadline</span>
                        <div id="detailDeadline" class="fw-medium">—</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="vac-detail-label">Posted on</span>
                        <div id="detailPostedBy" class="fw-medium">—</div>
                    </div>
                </div>
                <hr />
                <h6 class="fw-semibold mb-2">Job Description</h6>
                <p id="detailDescription" class="text-muted mb-4"></p>
                <h6 class="fw-semibold mb-2">Responsibilities</h6>
                <p id="detailRequirements" class="text-muted mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/employer.js" asp-append-version="true"></script>

    @if (hasNewVacancyErrors)
    {
        <script>
            // Reopen the Post Vacancy modal so validation errors are visible
            // after a full-page postback (Bootstrap modals don't survive reloads).
            document.addEventListener('DOMContentLoaded', function () {
                var modalEl = document.getElementById('postVacancyModal');
                if (modalEl) {
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }
            });
        </script>
    }
}

@functions {
    private static string Friendly(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var words = value.Replace("_", " ").ToLowerInvariant();
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(words);
    }
}
