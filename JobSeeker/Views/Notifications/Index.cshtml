@model IReadOnlyList<JobSeeker.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var selectedFilter = ViewBag.SelectedFilter as string;
    var unreadCount = ViewBag.UnreadCount is int count ? count : 0;
    var allNotifications = Model ?? new List<Notification>();
    var unreadNotifications = allNotifications.Where(n => !n.IsRead).OrderByDescending(n => n.CreatedAt).ToList();
    var readNotifications = allNotifications.Where(n => n.IsRead).OrderByDescending(n => n.CreatedAt).ToList();
}

<div class="notifications-page">
    <div class="jobs-page-heading">
        <div>
            <span class="section-eyebrow">Activity updates</span>
            <h1>Notifications</h1>
            <p>Review updates about your vacancies and account activity.</p>
        </div>
        @if (unreadCount > 0)
        {
            <span class="notification-unread-summary">@unreadCount unread</span>
        }
    </div>

    <div class="application-filter-bar">
        <a asp-action="Index"
           class="application-filter @(selectedFilter == null ? "active" : "")">All</a>
        <a asp-action="Index" asp-route-filter="unread"
           class="application-filter @(selectedFilter == "unread" ? "active" : "")">Unread</a>
        <a asp-action="Index" asp-route-filter="read"
           class="application-filter @(selectedFilter == "read" ? "active" : "")">Read</a>
        
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllAsRead" method="post" style="display: inline; margin-left: auto;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark all as read</button>
            </form>
        }
    </div>

    @if (!allNotifications.Any())
    {
        <div class="portal-card empty-job-list">
            <h3>No notifications here</h3>
            <p>Updates about your vacancy actions will appear in this section.</p>
        </div>
    }
    else if (selectedFilter == null)
    {
        <!-- Show all notifications organized by read/unread sections -->
        @if (unreadNotifications.Any())
        {
            <div class="notification-section">
                <h2 class="notification-section-title">Unread (@unreadNotifications.Count)</h2>
                <div class="notification-list">
                    @foreach (var notification in unreadNotifications)
                    {
                        <article class="notification-card unread">
                            <div class="notification-state" aria-hidden="true"></div>
                            <div class="notification-content">
                                <div class="notification-title-row">
                                    <div>
                                        <h2>@notification.Title</h2>
                                        <time datetime="@notification.CreatedAt.ToString("O")">
                                            @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")
                                        </time>
                                    </div>
                                    <span class="notification-read-status badge bg-warning">Unread</span>
                                </div>

                                <p>@notification.Message</p>

                                <div class="notification-actions">
                                    @if (!notification.IsRead)
                                    {
                                        <form asp-action="MarkAsRead" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@notification.NotificationId" />
                                            <input type="hidden" name="filter" value="@selectedFilter" />
                                            <button type="submit" class="btn btn-sm btn-primary">Mark as read</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }

        @if (readNotifications.Any())
        {
            <div class="notification-section" style="margin-top: 2rem;">
                <h2 class="notification-section-title">Read (@readNotifications.Count)</h2>
                <div class="notification-list">
                    @foreach (var notification in readNotifications)
                    {
                        <article class="notification-card read">
                            <div class="notification-state" aria-hidden="true"></div>
                            <div class="notification-content">
                                <div class="notification-title-row">
                                    <div>
                                        <h2>@notification.Title</h2>
                                        <time datetime="@notification.CreatedAt.ToString("O")">
                                            @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")
                                        </time>
                                    </div>
                                    <span class="notification-read-status badge bg-secondary">Read</span>
                                </div>

                                <p>@notification.Message</p>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <!-- Show filtered notifications -->
        <div class="notification-list">
            @foreach (var notification in allNotifications)
            {
                <article class="notification-card @(!notification.IsRead ? "unread" : "read")">
                    <div class="notification-state" aria-hidden="true"></div>
                    <div class="notification-content">
                        <div class="notification-title-row">
                            <div>
                                <h2>@notification.Title</h2>
                                <time datetime="@notification.CreatedAt.ToString("O")">
                                    @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")
                                </time>
                            </div>
                            <span class="notification-read-status @(notification.IsRead ? "badge bg-secondary" : "badge bg-warning")">
                                @(notification.IsRead ? "Read" : "Unread")
                            </span>
                        </div>

                        <p>@notification.Message</p>

                        <div class="notification-actions">
                            @if (!notification.IsRead)
                            {
                                <form asp-action="MarkAsRead" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@notification.NotificationId" />
                                    <input type="hidden" name="filter" value="@selectedFilter" />
                                    <button type="submit" class="btn btn-sm btn-primary">Mark as read</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
