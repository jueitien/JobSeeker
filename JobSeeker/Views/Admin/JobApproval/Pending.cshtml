@model JobSeeker.Models.ViewModels.Admin.JobApprovalViewModel
@{
    ViewData["Title"] = "Pending Job Approvals";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Postings</h2>
    <div class="d-flex gap-2">
        <a asp-action="Pending"  class="btn btn-warning btn-sm">Pending</a>
        <a asp-action="Approved" class="btn btn-outline-success btn-sm">Approved</a>
        <a asp-action="Rejected" class="btn btn-outline-danger btn-sm">Rejected</a>
    </div>
</div>

<div class="row g-3">
    @if (!Model.Jobs.Any())
    {
        <div class="col-12">
            <p class="text-muted text-center py-5">No pending job postings at this time.</p>
        </div>
    }
    else
    {
        @foreach (var job in Model.Jobs)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="mb-1">@job.JobTitle</h5>
                                <div class="text-muted small">@job.CompanyName</div>
                            </div>
                            <span class="badge bg-warning text-dark">Pending</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-light text-dark border">@job.EmploymentType</span>
                            @if (!string.IsNullOrEmpty(job.WorkplaceType))
                            {
                                <span class="badge bg-light text-dark border">@job.WorkplaceType</span>
                            }
                            @if (!string.IsNullOrEmpty(job.Location))
                            {
                                <span class="badge bg-light text-dark border">@job.Location</span>
                            }
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li>
                                <strong>Salary:</strong>
                                @if (job.MinimumSalary.HasValue || job.MaximumSalary.HasValue)
                                {
                                    @($"RM {job.MinimumSalary:N0} – RM {job.MaximumSalary:N0}")
                                }
                                else
                                {
                                    <text>Not specified</text>
                                }
                            </li>
                            @if (job.ApplicationDeadline.HasValue)
                            {
                                <li><strong>Deadline:</strong> @job.ApplicationDeadline.Value.ToString("dd MMM yyyy")</li>
                            }
                            <li><strong>Submitted:</strong> @job.CreatedAt.ToString("dd MMM yyyy")</li>
                        </ul>
                        <div class="d-flex gap-2">
                            <form asp-action="Approve" method="post" class="flex-fill">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@job.JobId" />
                                <button type="submit" class="btn btn-sm btn-success w-100">Approve</button>
                            </form>
                            <button type="button" class="btn btn-sm btn-danger flex-fill"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectJobModal-@job.JobId">
                                Reject
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reject Modal -->
            <div class="modal fade" id="rejectJobModal-@job.JobId" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Reject" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@job.JobId" />
                            <div class="modal-header">
                                <h5 class="modal-title">Reject "@job.JobTitle"</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <label class="form-label">Rejection Reason</label>
                                <textarea name="reason" class="form-control" rows="3"
                                          placeholder="Enter reason for rejection..."></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Confirm Reject</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
