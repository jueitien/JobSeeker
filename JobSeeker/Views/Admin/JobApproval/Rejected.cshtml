@model JobSeeker.Models.ViewModels.Admin.JobApprovalViewModel
@{
    ViewData["Title"] = "Rejected Job Postings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Postings</h2>
    <div class="d-flex gap-2">
        <a asp-action="Pending"  class="btn btn-outline-warning btn-sm">Pending</a>
        <a asp-action="Approved" class="btn btn-outline-success btn-sm">Approved</a>
        <a asp-action="Rejected" class="btn btn-danger btn-sm">Rejected</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Job Title</th>
                        <th>Company</th>
                        <th>Rejection Reason</th>
                        <th>Rejected By</th>
                        <th>Rejected At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Jobs.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">No rejected job postings found.</td></tr>
                    }
                    else
                    {
                        var i = 1;
                        @foreach (var job in Model.Jobs)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>@job.JobTitle</td>
                                <td>@job.CompanyName</td>
                                <td>@(job.RejectionReason ?? "—")</td>
                                <td>@(job.ApprovedByName ?? "—")</td>
                                <td>@(job.ApprovedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white">
        <span class="text-muted small">Showing @Model.TotalCount result(s)</span>
    </div>
</div>
