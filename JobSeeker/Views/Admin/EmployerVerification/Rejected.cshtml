@model JobSeeker.Models.ViewModels.Admin.EmployerVerificationViewModel
@{
    ViewData["Title"] = "Rejected Employers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Employer Verification</h2>
    <div class="d-flex gap-2">
        <a asp-action="Pending"  class="btn btn-outline-warning btn-sm">Pending</a>
        <a asp-action="Approved" class="btn btn-outline-success btn-sm">Approved</a>
        <a asp-action="Rejected" class="btn btn-danger btn-sm">Rejected</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Rejection Reason</th>
                        <th>Rejected By</th>
                        <th>Rejected At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Employers.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">No rejected employers found.</td></tr>
                    }
                    else
                    {
                        var i = 1;
                        @foreach (var e in Model.Employers)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>@e.CompanyName</td>
                                <td>@e.Email</td>
                                <td>@(e.VerificationRemarks ?? "—")</td>
                                <td>@(e.VerifiedByName ?? "—")</td>
                                <td>@(e.VerifiedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white">
        <span class="text-muted small">Showing @Model.TotalCount result(s)</span>
    </div>
</div>
