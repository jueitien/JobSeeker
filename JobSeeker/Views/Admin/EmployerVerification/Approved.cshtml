@model JobSeeker.Models.ViewModels.Admin.EmployerVerificationViewModel
@{
    ViewData["Title"] = "Approved Employers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Employer Verification</h2>
    <div class="d-flex gap-2">
        <a asp-action="Pending"  class="btn btn-outline-warning btn-sm">Pending</a>
        <a asp-action="Approved" class="btn btn-success btn-sm">Approved</a>
        <a asp-action="Rejected" class="btn btn-outline-danger btn-sm">Rejected</a>
    </div>
</div>

<form method="get" asp-action="Approved">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-5">
                    <input type="text" name="keyword" value="@Model.SearchKeyword"
                           class="form-control" placeholder="Search company name or email..." />
                </div>
                <div class="col-md-4">
                    <select name="industry" class="form-select">
                        <option value="">All Industries</option>
                        @foreach (var ind in new[] { "Technology", "Finance", "Healthcare", "Education" })
                        {
                            if (Model.FilterIndustry == ind)
                            { <option value="@ind" selected>@ind</option> }
                            else
                            { <option value="@ind">@ind</option> }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Company</th>
                        <th>Industry</th>
                        <th>Verified By</th>
                        <th>Verified At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Employers.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-5">No approved employers found.</td></tr>
                    }
                    else
                    {
                        var i = 1;
                        @foreach (var e in Model.Employers)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>
                                    <div class="fw-semibold">@e.CompanyName</div>
                                    <div class="small text-muted">@e.Email</div>
                                </td>
                                <td>@(e.Industry ?? "—")</td>
                                <td>@(e.VerifiedByName ?? "—")</td>
                                <td>@(e.VerifiedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white">
        <span class="text-muted small">Showing @Model.TotalCount result(s)</span>
    </div>
</div>
