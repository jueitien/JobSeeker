@model JobSeeker.Models.ViewModels.Admin.EmployerVerificationViewModel
@{
    ViewData["Title"] = "Pending Employer Verifications";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Employer Verification</h2>
    <div class="d-flex gap-2">
        <a asp-action="Pending"  class="btn btn-warning btn-sm">Pending</a>
        <a asp-action="Approved" class="btn btn-outline-success btn-sm">Approved</a>
        <a asp-action="Rejected" class="btn btn-outline-danger btn-sm">Rejected</a>
    </div>
</div>

<!-- Employer Cards -->
<div class="row g-3">
    @if (!Model.Employers.Any())
    {
        <div class="col-12">
            <p class="text-muted text-center py-5">No pending verifications at this time.</p>
        </div>
    }
    else
    {
        @foreach (var employer in Model.Employers)
        {
            var initials = string.Concat(employer.CompanyName.Split(' ').Take(2).Select(w => w.FirstOrDefault()));
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white fw-bold"
                                 style="width:52px;height:52px;font-size:18px;">
                                @initials.ToString().ToUpper()
                            </div>
                            <div>
                                <div class="fw-semibold">@employer.CompanyName</div>
                                <div class="text-muted small">@employer.Email</div>
                            </div>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li><strong>Industry:</strong> @(employer.Industry ?? "—")</li>
                            <li><strong>Company Size:</strong> @(employer.CompanySize ?? "—")</li>
                            <li><strong>Reg. No:</strong> @(employer.CompanyRegistrationNumber ?? "—")</li>
                            <li><strong>Registered:</strong> @employer.CreatedAt.ToString("dd MMM yyyy")</li>
                        </ul>
                        <div class="d-flex gap-2">
                            <form asp-action="Approve" method="post" class="flex-fill">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@employer.EmployerId" />
                                <button type="submit" class="btn btn-sm btn-success w-100">Approve</button>
                            </form>
                            <button type="button" class="btn btn-sm btn-danger flex-fill"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectModal-@employer.EmployerId">
                                Reject
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reject Modal -->
            <div class="modal fade" id="rejectModal-@employer.EmployerId" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Reject" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@employer.EmployerId" />
                            <div class="modal-header">
                                <h5 class="modal-title">Reject @employer.CompanyName</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <label class="form-label">Rejection Reason</label>
                                <textarea name="remarks" class="form-control" rows="3"
                                          placeholder="Enter reason for rejection..."></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Confirm Reject</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
