@model JobSeeker.Models.ViewModels.Admin.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>System Reports</h2>
</div>

<div class="row g-4">
    <!-- Generate Report -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Generate New Report</div>
            <div class="card-body">
                <form asp-action="Generate" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Report Type</label>
                        <select name="reportType" class="form-select">
                            <option value="">Select report type...</option>
                            <option value="USER_SUMMARY">User Summary Report</option>
                            <option value="EMPLOYER_VERIFICATION">Employer Verification Report</option>
                            <option value="JOB_POSTINGS">Job Postings Report</option>
                            <option value="APPLICATION_STATISTICS">Application Statistics Report</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date Range</label>
                        <div class="row g-2">
                            <div class="col">
                                <input type="date" name="dateFrom" class="form-control" />
                            </div>
                            <div class="col-auto d-flex align-items-center text-muted">to</div>
                            <div class="col">
                                <input type="date" name="dateTo" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-file-earmark-arrow-down me-1"></i> Generate &amp; Save to S3
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Report History -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Report History</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Report Name</th>
                                <th>Type</th>
                                <th>Generated By</th>
                                <th>Date</th>
                                <th>File</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Reports.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No reports generated yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var report in Model.Reports)
                                {
                                    <tr>
                                        <td>@report.ReportName</td>
                                        <td><span class="badge bg-secondary">@report.ReportType</span></td>
                                        <td>@report.GeneratedByName</td>
                                        <td>@report.GeneratedAt.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            @if (report.HasFile)
                                            {
                                                <a asp-action="Download" asp-route-id="@report.SystemReportId"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Download CSV (link valid for 10 min)">
                                                    <i class="bi bi-download me-1"></i>CSV
                                                    @if (report.FileSizeBytes.HasValue)
                                                    {
                                                        <span class="text-muted ms-1" style="font-size:0.75rem;">
                                                            (@FormatBytes(report.FileSizeBytes.Value))
                                                        </span>
                                                    }
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    static string FormatBytes(long bytes)
    {
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1_024)     return $"{bytes / 1_024.0:F1} KB";
        return $"{bytes} B";
    }
}
