@model JobSeeker.Models.ViewModels.Admin.UserManagementViewModel
@{
    ViewData["Title"] = "All Users";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>User Management</h2>
</div>

<!-- Filters -->
<form method="get" asp-action="Index">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" name="keyword" value="@Model.SearchKeyword"
                           class="form-control" placeholder="Search by name or email..." />
                </div>
                <div class="col-md-3">
                    <select name="role" class="form-select">
                        <option value="">All Roles</option>
                        @foreach (var r in new[] { "Job Seeker", "Employer", "Career Counsellor", "Administrator" })
                        {
                            if (Model.FilterRole == r)
                            { <option value="@r" selected>@r</option> }
                            else
                            { <option value="@r">@r</option> }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var (val, label) in new[] { ("ACTIVE","Active"),("PENDING","Pending"),("SUSPENDED","Suspended"),("DEACTIVATED","Deactivated") })
                        {
                            if (Model.FilterStatus == val)
                            { <option value="@val" selected>@label</option> }
                            else
                            { <option value="@val">@label</option> }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Users Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">No users found.</td>
                        </tr>
                    }
                    else
                    {
                        var i = 1;
                        @foreach (var user in Model.Users)
                        {
                            var initials = string.Join("", user.FullName.Split(' ').Take(2).Select(w => w.FirstOrDefault()));
                            <tr>
                                <td>@(i++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white"
                                             style="width:36px;height:36px;font-size:13px;">
                                            @initials.ToString().ToUpper()
                                        </div>
                                        <span>@user.FullName</span>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @{
                                        var roleBadge = user.Role switch {
                                            "Job Seeker"        => "bg-primary",
                                            "Employer"          => "bg-info text-dark",
                                            "Career Counsellor" => "bg-purple",
                                            "Administrator"     => "bg-dark",
                                            _                   => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @roleBadge">@user.Role</span>
                                </td>
                                <td>
                                    @{
                                        var statusBadge = user.AccountStatus switch {
                                            "ACTIVE"      => "bg-success",
                                            "SUSPENDED"   => "bg-warning text-dark",
                                            "DEACTIVATED" => "bg-danger",
                                            _             => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusBadge">@user.AccountStatus</span>
                                </td>
                                <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        @if (user.AccountStatus == "ACTIVE")
                                        {
                                            <form asp-action="Suspend" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning">Suspend</button>
                                            </form>
                                            <form asp-action="Deactivate" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Deactivate @user.FullName?')">
                                                    Deactivate
                                                </button>
                                            </form>
                                        }
                                        else if (user.AccountStatus == "SUSPENDED")
                                        {
                                            <form asp-action="Activate" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                            </form>
                                            <form asp-action="Deactivate" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Deactivate @user.FullName?')">
                                                    Deactivate
                                                </button>
                                            </form>
                                        }
                                        else if (user.AccountStatus == "DEACTIVATED")
                                        {
                                            <form asp-action="Activate" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
        <span class="text-muted small">Showing @Model.TotalCount user(s)</span>
        <a asp-action="Suspended" class="btn btn-sm btn-outline-warning">View Suspended Accounts</a>
    </div>
</div>
