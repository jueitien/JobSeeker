@model JobSeeker.Models.ViewModels.EditAccountViewModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="account-settings-page">
    <div class="page-title-row mb-4">
        <div>
            <h1>Account settings</h1>
            <p>Update the basic details used for your account and sign in.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success portal-alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger portal-alert">@errorMessage</div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="portal-card">
                <form asp-controller="Account" asp-action="EditAccount" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Profile image</label>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <img src="@(ViewBag.HasProfileImage == true ? Url.Action("ProfileImage", "Account") : Url.Content("~/images/default-avatar.svg"))"
                                 alt="Profile image"
                                 class="account-settings-profile-image" />
                            <div class="flex-grow-1">
                                <input type="file" name="profileImage" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                                <div class="form-text">JPG, PNG or WEBP, up to 5 MB. The image is stored privately in Amazon S3.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Save account</button>
                        @if (User.IsInRole(JobSeeker.Models.UserRoles.JobSeeker))
                        {
                            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Back to profile</a>
                        }
                    </div>
                </form>

                @if (ViewBag.HasProfileImage == true)
                {
                    <form asp-controller="Account" asp-action="RemoveProfileImage" method="post" class="mt-3" onsubmit="return confirm('Remove your profile image?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove profile image</button>
                    </form>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
